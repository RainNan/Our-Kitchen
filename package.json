{
  "name": "our-kitchen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "demo": "concurrently -k -n api,web \"node scripts/demo.js\" \"vite --host 127.0.0.1\"",
    "setup": "node scripts/setup.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "assets": "node scripts/fetch-assets.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-vue-next": "^0.468.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.9"
  }
}

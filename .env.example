NODE_ENV=production
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=https://kitchen.example.com
COOKIE_SECURE=true
# Run npm run setup to generate these values. Never use example credentials.
APP_SECRET=
ADMIN_PASSWORD_HASH=
GUEST_ANSWER_HASH=
GUEST_QUESTION=我们的专属暗号是？
DATA_DIR=./data
# Only explicitly trusted reverse proxy IPs/CIDRs, separated by commas. Empty = no proxy.
TRUST_PROXY=
# SCT... (Server酱 Turbo) or sctp... (Server酱³)
SERVERCHAN_SENDKEY=
